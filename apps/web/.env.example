# Copy to `.env` if you need to point the app at a non-default API. `.env` is git-ignored.

# Vite dev server port. 4173 rather than Vite's default 5173, which every other Vite
# project on the machine also claims. If you change it, change `CORS_ORIGIN` in
# `apps/api/.env` to match.
WEB_PORT=4173

# GraphQL endpoint.
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# socket.io server origin (same process as the API).
VITE_REALTIME_URL=http://localhost:4000
