# Copy to `.env` and adjust as needed. `.env` is git-ignored.

# Port for the HTTP server that serves GraphQL + socket.io.
PORT=4000

# MongoDB connection string. See README.md for how to run MongoDB locally.
MONGODB_URI=mongodb://127.0.0.1:27017/pulsechat

# Origin allowed to call the API from a browser (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# `production` disables the Apollo landing page and schema introspection.
NODE_ENV=development

# Optional: database used by the integration tests. Defaults to pulsechat_test on localhost.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/pulsechat_test
